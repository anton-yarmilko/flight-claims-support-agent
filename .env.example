# Copy to .env and `export $(cat .env | xargs)`, or set these in your shell.
# Leave everything empty to run the demo offline (rules + templates).

# groq | openrouter | gemini | ollama | openai | custom | off
LLM_PROVIDER=groq
LLM_API_KEY=
# Optional overrides
# LLM_MODEL=llama-3.1-8b-instant
# LLM_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# LLM_BASE_URL=            # only for LLM_PROVIDER=custom
# JUDGE_MODEL=llama-3.3-70b-versatile   # for python -m evals.judge
